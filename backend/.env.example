# System Configuration
PROJECT_NAME="AI-Powered Intelligent Traffic Monitoring & GenAI Platform"
API_V1_STR="/api"
SECRET_KEY="super-secret-key-change-in-production-traffic-ai-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration
# MongoDB connection URI (e.g., mongodb://localhost:27017)
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="traffic_ai_db"

# Fallback Local DB (SQLite/JSON persistence if MongoDB is offline)
USE_FALLBACK_DB_IF_MONGO_DISCONNECTED=true
SQLITE_DB_PATH="data/traffic_ai.db"

# Computer Vision & Detection Models
YOLO_MODEL_PATH="yolov8n.pt"
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45
FRAME_SKIP=2
MAX_DETECTIONS=100

# Violation & Accident Thresholds
HELMET_CONFIDENCE_THRESHOLD=0.50
PARKING_THRESHOLD_SECONDS=10.0
ACCIDENT_SCORE_THRESHOLD=0.65
SPEED_CALIBRATION_PIXELS_PER_METER=15.0

# GenAI & Ollama RAG Assistant
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
VECTOR_STORE_PATH="storage/vector_store"
